# Configurazione del BACKEND. Copiare in ".env" (root del repository o backend/) e compilare.
# Il file .env è ignorato da Git: non committare mai credenziali reali.
# Formato: KEY=valore, senza virgolette e senza spazi attorno a "=".
# In produzione (Render) le stesse chiavi si impostano come variabili d'ambiente del servizio.

# Profilo Spring: in locale è "dev" per default. In produzione impostare la VARIABILE D'AMBIENTE
# SPRING_PROFILES_ACTIVE=prod (non funziona se scritta in questo file).

# --- Database PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/squadra_dev
DB_USERNAME=squadra
DB_PASSWORD=
# Database separato per i test di integrazione (mvnw test)
TEST_DB_URL=jdbc:postgresql://localhost:5432/squadra_test
TEST_DB_USERNAME=squadra
TEST_DB_PASSWORD=
# Attenzione: una variabile d'ambiente di sistema con lo stesso nome (es. DB_PASSWORD impostata
# per un altro progetto) ha la precedenza su questo file.

# --- Frontend e CORS ---
FRONTEND_URL=http://localhost:5173
# Elenco separato da virgole delle origini ammesse
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- JWT ---
# Segreto HMAC di almeno 256 bit, codificato in Base64. Generarlo con:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#   bash:       openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=gestionale-squadra
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P14D
# false solo in locale su http://localhost; in produzione è sempre true
COOKIE_SECURE=false

# --- Email ---
# LOG = nessun invio reale (email scritte nei log). MAILJET = invio reale tramite Mailjet.
MAIL_MODE=LOG
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME=Gestionale Squadra
MAIL_MAX_ATTEMPTS=5
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_WEBHOOK_SECRET=

# --- OpenAI (predisposizione, disattivata) ---
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=PT20S

# --- Varie ---
# Limiti di richieste per IP su login, registrazione e refresh (soglie in application.yml)
RATE_LIMIT_ENABLED=true
# Swagger UI su /swagger-ui.html (attivo per default solo nel profilo dev)
SWAGGER_ENABLED=true
