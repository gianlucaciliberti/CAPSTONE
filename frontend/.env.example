# Copiare in frontend/.env (non versionato). Le variabili VITE_* finiscono nel bundle pubblico:
# non inserire MAI segreti qui.

# Base delle API. Con "/api/v1" le chiamate restano sulla stessa origine del sito:
# in sviluppo le inoltra il proxy di Vite, in produzione la rewrite del sito statico Render.
VITE_API_BASE_URL=/api/v1

# Solo sviluppo: indirizzo del backend Spring Boot verso cui il proxy di Vite inoltra /api.
VITE_DEV_BACKEND_URL=http://localhost:8080
